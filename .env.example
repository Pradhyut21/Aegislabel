# Local native default uses SQLite; Docker Compose uses PostgreSQL.
DATABASE_URL=sqlite:///./artifacts/aegis.db
DEMO_AUTHOR_PASSWORD=Aegis-author-2026!
DEMO_REVIEWER_PASSWORD=Aegis-reviewer-2026!
# Explicit opt-in only after authorization for paid usage.
AI_ENABLED=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Local host allowlist; only enable Secure cookies behind local HTTPS.
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false

# Native Meta SDK mode; remains disabled unless explicitly opted in.
AI_PROVIDER=openai-compatible
LLAMA_API_KEY=
LLAMA_MODEL=
LLAMA_API_BASE_URL=https://api.llama.com/v1

# Current Meta Model API (Muse); alternative to legacy native Llama API.
# AI_PROVIDER=meta-model
MODEL_API_KEY=
MODEL_API_MODEL=muse-spark-1.3
