# Local native default uses SQLite; Docker Compose uses PostgreSQL.
DATABASE_URL=sqlite:///./artifacts/aegis.db
DEMO_AUTHOR_PASSWORD=Aegis-author-2026!
DEMO_REVIEWER_PASSWORD=Aegis-reviewer-2026!
# Explicit opt-in only after authorization for paid usage.
AI_ENABLED=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Local host allowlist; only enable Secure cookies behind local HTTPS.
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
